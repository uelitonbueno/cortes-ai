# Variáveis de ambiente do Cortes AI
# Copie este arquivo para `.env` e preencha os valores.

# ---------------------------------------------------------------
# Aplicação e autenticação (fornecidas pelo ambiente de runtime)
# ---------------------------------------------------------------
VITE_APP_ID=app_XXXXXXXXXXXXXXXX
JWT_SECRET=secret-aleatorio-256-bits
OAUTH_SERVER_URL=https://oauth.manus.im
OWNER_OPEN_ID=openid-do-owner

# ---------------------------------------------------------------
# Banco de dados MySQL (Drizzle)
# ---------------------------------------------------------------
DATABASE_URL=mysql://usuario:senha@localhost:3306/cortes_ai

# ---------------------------------------------------------------
# Fila de tarefas Redis
# ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------
# Armazenamento de objetos (Forge/S3)
# ---------------------------------------------------------------
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=chave-do-forge

# ---------------------------------------------------------------
# Pipeline de workers
# ---------------------------------------------------------------
# Token secreto usado pelos workers para autenticar os callbacks.
PIPELINE_CALLBACK_TOKEN=token-secreto-gerado-com-openssl-rand-hex-32

# URL pública da aplicação, usada pelos workers para chamar o callback.
PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# Publicação em plataformas (opcional até ativar o envio automático)
# ---------------------------------------------------------------
YOUTUBE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
YOUTUBE_PUBLISH_ENDPOINT=
TIKTOK_PUBLISH_ENDPOINT=
INSTAGRAM_PUBLISH_ENDPOINT=

# ---------------------------------------------------------------
# LLM (opcional; quando ausente, usa o runtime padrão do template)
# ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_BASE=
